FROM node:20-alpine AS base
RUN apk add --no-cache libc6-compat python3 make g++
WORKDIR /app

# Set CI environment for non-interactive pnpm operations
ENV CI=true
ENV PYTHON=/usr/bin/python3
RUN ln -sf python3 /usr/bin/python

# ---
FROM base AS prepare
RUN npm install -g pnpm@10.25.0 turbo@^2
COPY . .
RUN turbo prune awareness-service-api --docker

# ---
FROM base AS builder
RUN npm install -g pnpm@10.25.0
# First install the dependencies (as they change less often)
COPY --from=prepare /app/out/json/ .
# Copy full source for packages that need postinstall builds (signature-validator)
COPY --from=prepare /app/out/full/infrastructure/signature-validator infrastructure/signature-validator
RUN pnpm install --frozen-lockfile
# Build the project
COPY --from=prepare /app/out/full/ .
RUN pnpm turbo build --filter=awareness-service-api

# ---
FROM base AS runner
# Copy the app and its workspace deps to their ORIGINAL paths. pnpm creates
# relative symlinks inside node_modules, so relocating any package would break
# module resolution at runtime.
COPY --from=builder /app/infrastructure/signature-validator/ ./infrastructure/signature-validator/
COPY --from=builder /app/services/awareness-service/api/ ./services/awareness-service/api/
# Workspace config + root node_modules (pnpm store + workspace links)
COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/node_modules ./node_modules

WORKDIR /app/services/awareness-service/api

EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:4100/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

CMD ["node", "dist/index.js"]
